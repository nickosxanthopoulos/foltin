import os
import sys
import traci

# Ensure SUMO is in your system path
if 'SUMO_HOME' in os.environ:
    tools = os.path.join(os.environ['SUMO_HOME'], 'tools')
    sys.path.append(tools)
else:
    sys.exit("Please declare environment variable 'SUMO_HOME'")

# Dynamically find the config file in the same folder as this script
script_dir = os.path.dirname(os.path.abspath(__file__))
config_path = os.path.join(script_dir, "ilioupoli.sumocfg.cfg")

# Launch SUMO 
sumoBinary = "sumo-gui"  
sumoCmd = [sumoBinary, "-c", config_path,"--scale", "0.5" ] # afairethike to scale    
traci.start(sumoCmd)

ambulance_start_time = -1
step = 0
active_tls = ""  # <-- EDW EINAI H LUSH STO PROVLHMA SOU!

while step < 6000:
    traci.simulationStep()

    active_vehicles = traci.vehicle.getIDList()
    arrived_vehicles = traci.simulation.getArrivedIDList()
    # Vriskoume poia oxhmata mphkan ston xarth se auto to step
    # Vriskoume poia oxhmata mphkan ston xarth se auto to step
    # Vriskoume poia oxhmata mphkan ston xarth
    departed_vehicles = traci.simulation.getDepartedIDList()
    
    for veh_id in departed_vehicles:
        # Εξαιρούμε το ασθενοφόρο ΚΑΙ τα λεωφορεία (που προκαλούν τα κόκκινα σφάλματα)
        if veh_id != "AMBULANCE_01" and "bus" not in veh_id:
            # Το % 10 < 4 σημαίνει ότι διαγράφουμε το 40% της κίνησης
            if hash(veh_id) % 10 < 4:
                try:
                    traci.vehicle.remove(veh_id, 3)
                except traci.exceptions.TraCIException:
                    pass
    # 1. Katagrafh xronou
    if "AMBULANCE_01" in active_vehicles and ambulance_start_time == -1:
        ambulance_start_time = step
        print(f"\n[INFO] To asthenoforo ksekinhse th diadromh sto step {step}")

    # 2. Ypologismos synolikou xronou & Reset fanariou otan termatisei
    if "AMBULANCE_01" in arrived_vehicles:
        total_time = step - ambulance_start_time
        print(f"\n!!! TO ASTHENOFORO EFTASE STON PROORISMO TOU !!!")
        print(f"--> Sunolikos Xronos Taxidiou: {total_time} deuterolepta.\n")
        
        if active_tls != "":
            try:
                traci.trafficlight.setProgram(active_tls, "0")
            except traci.exceptions.TraCIException:
                pass

    # 3. To APOLYTO Dynamiko Green Wave gia ola ta fanaria (Me Fysikes Faseis asfaleias)
    if "AMBULANCE_01" in active_vehicles:
        upcoming_tls = traci.vehicle.getNextTLS("AMBULANCE_01")
        
        if len(upcoming_tls) > 0:
            next_tls_info = upcoming_tls[0]
            tls_id = next_tls_info[0]
            tls_index = next_tls_info[1]
            distance = next_tls_info[2]
            
            # Entopismos sta 150 metra makria
            if distance < 150.0:
                try:
                    # Reset sto prohgoumeno fanari otan paei se neo
                    if active_tls != "" and active_tls != tls_id:
                        traci.trafficlight.setProgram(active_tls, "0") 
                        
                    active_tls = tls_id
                    
                    # Diavazoume ta episima asfalh programmata tou fanariou
                    logics = traci.trafficlight.getCompleteRedYellowGreenDefinition(tls_id)
                    if len(logics) > 0:
                        current_logic = logics[0]
                        best_phase = -1
                        
                        # Psaxnoume ti fash pou exei Prasino (G i g) gia ti lwrida tou asthenoforou
                        for i, phase in enumerate(current_logic.phases):
                            if len(phase.state) > tls_index and phase.state[tls_index] in ('G', 'g'):
                                best_phase = i
                                break
                        
                        # Efarmouzoume tin pragmatikh, asfalh fash!
                        if best_phase != -1:
                            traci.trafficlight.setPhase(tls_id, best_phase)
                            traci.trafficlight.setPhaseDuration(tls_id, 100)
                    
                except traci.exceptions.TraCIException:
                    pass
        
        # An to asthenoforo ta perase ola, kleinei to Green Wave gia na kseblokarei h polh
        elif active_tls != "":
            try:
                traci.trafficlight.setProgram(active_tls, "0")
                active_tls = ""
            except traci.exceptions.TraCIException:
                pass

    # 4. Statistika ana 100 vimata
    if step % 100 == 0:
        stopped_cars = 0
        total_delay = 0

        for veh_id in active_vehicles:
            try:
                wait_time = traci.vehicle.getWaitingTime(veh_id)
                if wait_time > 0:
                    stopped_cars += 1
                    total_delay += wait_time
            except traci.exceptions.TraCIException:
                # Αν το όχημα διαγράφηκε και δεν υπάρχει πια, το αγνοούμε
                pass

        print(f"Step {step}: {len(active_vehicles)} total cars. "
              f"{stopped_cars} are currently stopped (Total accumulated delay: {total_delay} seconds).")

    # Ayksisi tou vhmatos
    step += 1

# Kleisimo ths sundeshs
traci.close()
print("Simulation finished.")
